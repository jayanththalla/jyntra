# Required. Matches docker-compose.yml (run `npm run db:up` first).
# You can point this at any PostgreSQL instead.
DATABASE_URL=

# Optional. Locks the WHOLE site behind one login (username "admin" unless APP_USER is set).
# Leave empty for a public site where everyone creates their own profile.
APP_PASSWORD=

# Optional but needed for scheduled refreshes (16+ characters). Protects:
#   POST /api/cron/refresh?scope=all|news|discovery   header  Authorization: Bearer <value>
# If empty, the refresh endpoints stay CLOSED. See docs/SCHEDULING.md.
CRON_SECRET=

# Optional. Brave Search API key (https://brave.com/search/api/).
# When set, the "search" source runs profile-based queries and follows
# public ATS job-board links (Greenhouse / Lever / Ashby). Leave empty to skip.
SEARCH_API_KEY=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# DEPRECATED: Google closed the Custom Search JSON API to new customers and retires it on 2027-01-01.
# Only fill these in if you already have a working key; otherwise leave empty. Funding news works without them (RSS).
# Get your API key: https://developers.google.com/custom-search/v1/overview
# Get your CX (Search Engine ID): https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Optional. Tavily news search (https://tavily.com, free plan: 1,000 credits/month). One bounded query per refresh.
TAVILY_API_KEY=

# AI Outreach Generation (Free Groq or Google Gemini API)
# Groq (Free fast Llama-3): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (Free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# Optional. Raises GitHub search limits for the Open Source page (10 -> 30 searches/min). No scopes needed.
GITHUB_TOKEN=

# Optional. Public contact email shown on the Contact page and footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Career AI (knowledge base) ---
# Required to connect GitHub/Codeforces/etc. Encrypts stored credentials (AES-256-GCM). 32+ random chars. Without it, credential-based connectors are disabled.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KB_ENCRYPTION_KEY=
# Optional GitHub OAuth app (github.com/settings/developers). Callback URL: <APP_URL>/api/kb/github/callback. Scope requested: read:user, repo (read-only use).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL used to build the OAuth redirect (e.g. https://jyntra.example.com). Defaults to the request origin.
APP_URL=

# --- Credential encryption (Gmail app passwords) ---
# REQUIRED to save a Gmail App Password. Stored passwords are AES-256-GCM encrypted with a key derived from this value;
# the key lives only in the server environment (never in the database or git). 32+ random characters.
# Falls back to KB_ENCRYPTION_KEY if empty. Rotating it makes saved passwords undecryptable: users re-enter them.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# --- Career GPT: email (Gmail API, send-only) ---
# Create an OAuth client (Web application) in Google Cloud, enable the Gmail API, add the redirect URI
# <APP_URL>/api/comms/gmail/callback and the scope gmail.send. Refresh tokens are stored encrypted with CREDENTIAL_ENCRYPTION_KEY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Google uses the SAME client (identity scopes only). Also add this redirect URI in Google Cloud:
#   <APP_URL>/api/auth/google/callback
# It needs CREDENTIAL_ENCRYPTION_KEY (16+ chars) because it signs the short-lived login ticket cookie. Unset = the Google button is hidden.
# Optional model overrides (defaults are in lib/ai/outreach.ts)
GROQ_MODEL=
GEMINI_MODEL=

# --- Providers (optional switches) ---
# Himalayas remote jobs are on by default. Set to false to disable the provider; other sources keep working.
# HIMALAYAS_ENABLED=false
# GDELT funding-news search is OFF by default (secondary provider; RSS feeds are primary). No key needed.
# GDELT_ENABLED=true

# --- Voice interview (Career tools > Mock interview > Voice interview) ---
# Speech-to-text and text-to-speech use Sarvam (server-side only; the key never reaches the browser). Free credits are limited.
# SARVAM_API_KEY=
# Only documented model ids are accepted; leave unset to use the API defaults.
# SARVAM_STT_MODEL=
# SARVAM_TTS_MODEL=
# SARVAM_TTS_SPEAKER=
# sarvam | off          (speech-to-text)
# VOICE_STT_PROVIDER=sarvam
# sarvam | browser | off (browser = the browser's own voice, no key)
# VOICE_TTS_PROVIDER=sarvam
# auto | groq | gemini  (interviewer model; uses GROQ_API_KEY / GEMINI_API_KEY)
# VOICE_LLM_PROVIDER=auto
# Limits (clamped to safe ranges)
# VOICE_MAX_TURNS=10
# VOICE_MAX_MINUTES=30
# VOICE_MAX_AUDIO_SECONDS=90
# VOICE_MAX_AUDIO_BYTES=4000000
# VOICE_AUDIO_RETENTION_DAYS=7
# VOICE_MAX_ACTIVE_SESSIONS=2

# Atlas: set to false to disable the automatic stale-index check and background re-sync before answers.
# ATLAS_AUTO_REFRESH=false

# BLR Startup Arena job lists (optional, off by default). Discovery still uses BLRARENA_ENABLED.
# Company-directory job sync is a separate scheduler scope: POST /api/cron/refresh?scope=companies
# or `npm run refresh -- companies`. Slugs come from data/blrarena-slugs.txt (not a hardcoded PwC list).
# BLRARENA_ENABLED=true
# BLRARENA_COMPANY_SLUGS=pwc,example-co
# COMPANY_JOBS_CONCURRENCY=3
# Optional HTTPS logo provider, used only after a verified company website is known. {domain} is replaced.
# COMPANY_LOGO_PROVIDER_URL=

# City company boards (Hyderabad etc.): data/boards.json is synced by `POST /api/cron/refresh?scope=boards`
# (GitHub workflow .github/workflows/boards.yml, every 2 hours) or `npm run refresh -- boards`.
# COMPANY_BOARDS_CONCURRENCY=3

# ── Automated job ingestion (see docs/INGESTION.md) ──────────────────────────────────────────────
# Nothing here is a credential for a third party. All supported ATS feeds are public and unauthenticated.
JOB_INGESTION_ENABLED=true
JOB_INGESTION_CONCURRENCY=5
JOB_DISCOVERY_ENABLED=true
JOB_DISCOVERY_DAILY_LIMIT=100         # board-validation fetches per UTC day
JOB_PROVIDER_TIMEOUT_MS=20000
JOB_SYNC_DEFAULT_INTERVAL_MINUTES=180 # per-source override: job_sources.poll_interval_minutes
JOB_SYNC_SECRET=                      # 16+ chars. Admin diagnostics + admin actions (Bearer). CRON_SECRET also works. Closed if both unset.
# Optional:
# JOB_REGISTRY_URL=https://raw.githubusercontent.com/smresponsibilities/jobscraper_hourly/main/companies.json   # weekly candidate import by the worker
# JOB_DISCOVERY_CDX=true              # Internet Archive CDX incremental discovery in the worker
# JOB_WORKER_HEALTH_PORT=8081         # GET / → last pass summary
# JOB_SYNC_BUDGET_MS=480000           # time budget of `npm run jobs:sync`

# ── Bengaluru / Hyderabad / Chennai data supply chain ──
# GITHUB_TOKEN=                       # optional: lets inventory discovery use the GitHub contents API (falls back to the repo tree page without it)
# JOB_DISCOVERY_DAILY_LIMIT=1500      # board-validation fetches per UTC day (≈29k inventory candidates → ~3 weeks at 1500/day)
# JOB_DISCOVERY_BATCH=200             # candidates validated per 15-minute worker cycle
# JOB_DISCOVERY_CONCURRENCY=4
# JOB_DISCOVERY_INVENTORY=true        # daily incremental + weekly forced ATS inventory import
# JOB_DISCOVERY_COMMONCRAWL=true      # incremental Common Crawl board discovery (cursor persisted)
# JOB_SUPPLEMENTAL_MANIFEST=true      # daily read-only manifest check of the supplemental dataset

# ── Interview v2: realtime voice (all optional; the app starts and works without them) ──
# OPENAI_API_KEY=                     # enables LIVE two-way voice (WebRTC). Server-side only: the browser only ever gets a ~2 minute credential
# OPENAI_REALTIME_MODEL=gpt-realtime-mini   # optional override
# OPENAI_REALTIME_VOICE=marin         # optional override
# VOICE_REALTIME_PROVIDER=none        # set to "none" to switch live voice off even when a key exists
# (Recorded-answer voice + typing keep working with the existing GROQ/GEMINI/SARVAM keys; the AI evaluator uses GROQ_API_KEY or GEMINI_API_KEY.)

# ── Funding connectors and company link verification (all optional) ──
# FUNDING_NEWS_REFRESH_ENABLED=true             # false = background refresh off (the `npm run funding:refresh` command still works)
# FUNDING_NEWS_REFRESH_INTERVAL_MINUTES=360     # 5..1440
# FUNDING_CONNECTORS_ENABLED=true
# FUNDING_EXTRA_FEEDS=                          # "Name|https://feed.url,Name2|https://…"   news publications (HTTPS only)
# FUNDING_OFFICIAL_FEEDS=                       # company press-release / investor announcement feeds → stories marked "official"
# FUNDING_INVESTOR_FEEDS=                       # VC portfolio-news / blog feeds → marked "official"
# COMPANY_ENRICHMENT_ENABLED=true               # verified website / LinkedIn / careers links for funded companies
